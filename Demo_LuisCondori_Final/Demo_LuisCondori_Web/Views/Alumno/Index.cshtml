@model IEnumerable<Demo_LuisCondori.Entidad.Entidad.Alumno>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create", "", new {@class = "btn btn-success"})
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Codigo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombres)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ApePaterno)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ApeMaterno)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PromedioFinal)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Apellidos)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Estado)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Codigo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nombres)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ApePaterno)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ApeMaterno)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PromedioFinal)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Apellidos)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Estado)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { codigo=item.Codigo }, new {@class = "btn btn-warning text-white"})
            @Html.ActionLink("Details", "Details", new { codigo=item.Codigo }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Delete", "Delete", new { codigo=item.Codigo }, new { @class = "btn btn-danger" })
        </td>
    </tr>
}

</table>
<em>
    @ViewBag.mensaje
</em>
